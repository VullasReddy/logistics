# ---------------------------------------------------------------
# Copy this file to .env and change the values.
#   cp .env.example .env
# NEVER commit the real .env file to Git.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet360
TEST_DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleet360_test

# Redis: leave EMPTY if Redis is not installed (Windows). Set redis://localhost:6379 if it is.
REDIS_URL=

# JWT - use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Frontend URL(s) allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:5173

# Login protection
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# File storage (company logo). Leave S3_BUCKET empty to store files locally.
S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for MinIO / local S3. Leave empty for real AWS.
S3_ENDPOINT=
S3_PUBLIC_URL=

# Set to true to insert demo data (branches, users, subscriptions) on start
SEED_DEMO=false
